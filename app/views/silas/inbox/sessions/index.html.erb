<% content_for :header_extra do %>
  <% if @pending_total.positive? %>
    <%= link_to "#{@pending_total} awaiting approval", inbox_sessions_path(pending: 1), class: "badge" %>
  <% end %>
<% end %>

<% if @agent_names && @agent_names.size > 1 %>
  <div class="agent-filter">
    <%= link_to "all", inbox_sessions_path, class: params[:agent].blank? ? "chip chip-on" : "chip" %>
    <% @agent_names.each do |name| %>
      <%= link_to name, inbox_sessions_path(agent: name),
            class: [ "chip", ("chip-on" if params[:agent] == name), ("chip-orphan" if @orphaned_agents&.include?(name)) ].compact.join(" "),
            title: (@orphaned_agents&.include?(name) ? "history only — app/agents/#{name} no longer exists" : nil) %>
    <% end %>
  </div>
<% end %>

<div class="card composer">
  <%= form_with url: inbox_sessions_path do |f| %>
    <% roster = Silas.named_agent_scopes.keys.sort %>
    <% if roster.any? %>
      <%= f.select :agent, [ [ "agent (root)", "" ] ] + roster.map { |a| [ a, a ] },
            {}, class: "composer-agent" %>
    <% end %>
    <%= f.text_area :input, rows: 2, required: true, class: "composer-input",
          placeholder: "Start a new session…" %>
    <div class="composer-row">
      <span></span>
      <%= f.submit "Start session", class: "btn send" %>
    </div>
  <% end %>
</div>

<% if @sessions.empty? && @held_sessions.empty? %>
  <div class="empty">No agent sessions yet — start one above.</div>
<% else %>
  <%# 06: the rail, grouped by who's blocked. Held = a person is needed —
      loaded by its own query so it is COMPLETE, not a partition of this page
      (a held session older than the newest fifty must still appear here).
      Working = a worker holds it; Filed = nothing needs anyone. %>
  <%
    working, filed = @sessions.partition { |s| s.turns.any? { |t| %w[queued running].include?(t.status) } }
  %>
  <% { "Held" => @held_sessions, "Working" => working, "Filed" => filed }.each do |title, group| %>
    <% next if group.empty? %>
    <div class="rail-title"><%= title %></div>
    <%= render partial: "silas/inbox/sessions/row", collection: group, as: :session,
               locals: { pending_counts: @pending_counts } %>
  <% end %>
  <% if @next_before %>
    <div class="pager">
      <%= link_to "Older sessions →",
            inbox_sessions_path(before: @next_before, agent: params[:agent].presence, pending: params[:pending].presence),
            class: "chip" %>
    </div>
  <% end %>
<% end %>
