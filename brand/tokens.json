{
  "$meta": {
    "name": "Silas",
    "direction": "Signals",
    "version": "1.0.0",
    "note": "Dark-first. One white lamp as the accent; it never expresses state. Four aspect colours (running/waiting/in_doubt/completed) plus failed plus a lampless dashed 'canceled' cover the seven run states.",
    "source": "danielstpaul/silas — app/views/layouts/silas/inbox.html.erb"
  },
  "color": {
    "dark": {
      "bg": "#0F1013",
      "panel": "#16181D",
      "ink": "#E9EBEF",
      "muted": "#969CA8",
      "line": "#262A33",
      "greyBg": "#1D2027",
      "accent": "#F2F4F8",
      "accentSoft": "#1D2027"
    },
    "light": {
      "bg": "#F4F4F2",
      "panel": "#FFFFFF",
      "ink": "#15171B",
      "muted": "#5B5F68",
      "line": "#DCDEE3",
      "greyBg": "#EDEEF1",
      "accent": "#274FBF",
      "accentSoft": "#E3E9FA"
    }
  },
  "status": {
    "queued": {
      "dark": {
        "fg": "#969CA8",
        "bg": "#1D2027"
      },
      "light": {
        "fg": "#5B5F68",
        "bg": "#EDEEF1"
      },
      "uiLabel": "queued",
      "means": "in line, not started"
    },
    "running": {
      "dark": {
        "fg": "#58A6FF",
        "bg": "#14233D"
      },
      "light": {
        "fg": "#1D4ED8",
        "bg": "#DCE7F5"
      },
      "uiLabel": "running",
      "pulse": true,
      "means": "a worker holds it"
    },
    "waiting": {
      "dark": {
        "fg": "#E3B341",
        "bg": "#2E2611"
      },
      "light": {
        "fg": "#92650E",
        "bg": "#FBEED0"
      },
      "uiLabel": "held",
      "means": "parked at zero compute, needs a person"
    },
    "in_doubt": {
      "dark": {
        "fg": "#B49AE8",
        "bg": "#241E33"
      },
      "light": {
        "fg": "#63459B",
        "bg": "#EAE3F7"
      },
      "uiLabel": "in_doubt",
      "style": "dashed outline, no fill",
      "means": "a crash made the effect ambiguous"
    },
    "completed": {
      "dark": {
        "fg": "#3FB950",
        "bg": "#12291B"
      },
      "light": {
        "fg": "#157A3D",
        "bg": "#DCF3E3"
      },
      "uiLabel": "clear",
      "means": "answered"
    },
    "failed": {
      "dark": {
        "fg": "#F85149",
        "bg": "#331815"
      },
      "light": {
        "fg": "#B91C1C",
        "bg": "#FBDCDA"
      },
      "uiLabel": "failed",
      "means": "broke — the only thing that gets red"
    },
    "canceled": {
      "dark": {
        "fg": "#737A87",
        "border": "#4A5160"
      },
      "light": {
        "fg": "#5B5F68",
        "border": "#C7CAD1"
      },
      "style": "dashed outline, no fill",
      "uiLabel": "canceled",
      "means": "a person stopped it, not a fault"
    }
  },
  "invocationStatus": {
    "pending": "queued",
    "started": "running",
    "required": "waiting",
    "approved": "completed",
    "declined": "failed",
    "expired": "canceled",
    "in_doubt": "in_doubt"
  },
  "type": {
    "display": {
      "family": "Archivo",
      "weights": [
        500,
        700,
        800
      ],
      "fallback": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "scope": "docs, README, wordmark"
    },
    "ui": {
      "family": "system",
      "stack": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "scope": "the shipped product UI"
    },
    "mono": {
      "family": "Space Mono",
      "weights": [
        400,
        700
      ],
      "fallback": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      "scope": "code, tool names, ledger values, labels"
    }
  },
  "radius": {
    "control": "6px",
    "card": "8px",
    "pill": "4-6px",
    "favicon": "7px"
  }
}